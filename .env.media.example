# Copia esto a .env (sin .example) y rellena los valores.
# .env NO debe subirse a git — ya está en .gitignore.

PUID=1000
PGID=1000
TZ=Europe/Madrid

# Rutas por defecto: relativas al repo, dentro de ./data (creadas solas al
# levantar el stack, ignoradas por git). Sirven para arrancar en cualquier
# equipo sin tener aún el NAS/servidor definitivo.
#
# Cuando tengas las rutas reales del servidor (p. ej. un disco montado en
# /mnt/biblioteca), cámbialas aquí por rutas absolutas del host — no hace
# falta tocar docker-compose.media.yml.
MEDIA_ROOT=./data/media
DOWNLOADS_ROOT=./data/downloads
CONFIG_ROOT=./data/config
